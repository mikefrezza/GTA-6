{
  "expo": {
    "name": "Night Rep",
    "slug": "night-rep",
    "owner": "k0-endurance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07060d",
    "scheme": "nightrep",
    "ios": {
      "bundleIdentifier": "com.nightrep.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Night Rep"
      }
    },
    "android": {
      "package": "app.nightrep.checklist",
      "adaptiveIcon": {
        "backgroundColor": "#07060d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07060d",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "655fe849-94f0-4bea-82ec-cc9546536109"
      }
    }
  }
}
